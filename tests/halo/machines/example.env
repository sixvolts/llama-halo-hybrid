# Copy to $HALO_MACHINE_DIR/<hostname -s>.env (default ~/.config/halo-test). Every line is optional.
#
# A llama-server you run permanently on this machine. When these are set the suites stop it before using the GPUs
# (one SIGTERM to the pid in PROD_PIDFILE) and start PROD_LAUNCHER again when they finish. Leave them unset and
# nothing is stopped or started.
#PROD_LAUNCHER=/path/to/your/server-launcher.sh
#PROD_PIDFILE=/path/to/your/server.pid
#PROD_HEALTH=http://127.0.0.1:8080/health
